# 同じ Wi-Fi の実機で試すとき(npm run dev:lan・dev:lan:quick)の設定。エミュレータだけにつなぐので、秘密の値はない。
# 手順は docs/development-guidelines.md「同じ Wi-Fi の実機で試す」
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-number-together.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-number-together
VITE_FIREBASE_PROJECT_ID=demo-number-together
VITE_FIREBASE_APP_ID=demo-app-id
VITE_USE_EMULATOR=true
# エミュレータのつなぎ先を、開いたページのホスト(開発用の PC のアドレス)にする
VITE_EMULATOR_HOST=page
